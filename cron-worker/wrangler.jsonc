{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "patient-radar-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": { "RADAR_ORIGIN": "https://patient-radar.pages.dev" },
  "triggers": {
    "crons": [
      "0 18 * * MON-FRI",   // 03:00 KST 월~금 · 정기 측정(요일 분산)
      "30 23 * * SUN",    // 08:30 KST 월요일 · 지난주 리포트 생성·발송
      "0 0 * * MON",      // 09:00 KST 월요일 · 리포트 이어서(12분 예산 초과분, KV 커서)
      "0 19 * * *",     // 04:00 KST 매일 · 리뷰 본문 수집 + 부정 리뷰 메일
      "0 20 * * *"      // 05:00 KST 매일 · 리뷰 이어서(12분 예산 초과분, KV 커서)
    ]
  },
  "kv_namespaces": [{ "binding": "STATE", "id": "b54bf209e88f4ca89fef22ade1bdf5d9" }]
  // secrets: CRON_SECRET (= ~/.ps-keys/radar-cron.key, 앱과 동일 값)
}
