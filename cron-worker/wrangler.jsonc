{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "patient-radar-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": { "RADAR_ORIGIN": "https://patient-radar.pages.dev" },
  "triggers": {
    "crons": [
      // 【2026-09-26】정기 측정 = KST 월~금 00:05~07:50, 15분마다 12분씩 큐 이어서(병원 수백 곳이면 한 번 15분으로 부족).
      // 예전 "0 18 * * MON-FRI"(UTC) 는 KST 화~토 03:00 이라 월요일(id%5==0) 병원이 한 번도 측정되지 않았다 → UTC SUN-THU 로 바로잡음.
      // 분을 :05 로 비켜 리뷰 수집(04:00~05:45, :00/:15/:30/:45)과 겹치지 않게(리뷰가 도는 동안 측정은 양보).
      "5,20,35,50 15-22 * * SUN-THU",
      // 【2026-09-26】측정 저녁 창 = KST 월~금 19:05~23:50 — 새벽에 못 끝낸 그날 차례를 이어서(같은 날 큐). 500곳 기준 하루 측정 5.6~7.6시간 필요
      "5,20,35,50 10-14 * * MON-FRI",
      "30 23 * * SUN",    // 08:30 KST 월요일 · 지난주 리포트 생성·발송
      "0 0 * * MON",      // 09:00 KST 월요일 · 리포트 이어서(12분 예산 초과분, KV 커서)
      // 【2026-09-26】리뷰 = KST 매일 04:00~05:45 15분마다 이어서(KV 커서). 목록을 다 돌면 그날 나머지는 건너뜀. 트리거 수를 늘리지 않게 한 줄로 합침
      "0,15,30,45 19-20 * * *"
    ]
  },
  "kv_namespaces": [{ "binding": "STATE", "id": "b54bf209e88f4ca89fef22ade1bdf5d9" }]
  // secrets: CRON_SECRET (= ~/.ps-keys/radar-cron.key, 앱과 동일 값)
}
