{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patient-radar",
  "compatibility_date": "2026-09-17",
  "pages_build_output_dir": "./dist",
  "vars": {
    "PUBLIC_ORIGIN": "https://patientradar.kr",
    "NAVER_HTML_MODE": "true", // 원장 결정 대기: 공식 검색 API 키(NAVER_CLIENT_ID/SECRET)를 넣으면 이 값을 지우고 API 모드로 전환
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "patient-radar-production",
      "database_id": "fc9ea01c-5f65-4ea5-a534-cd7a50005669",
    },
  ],
}
