{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patient-radar",
  "compatibility_date": "2026-09-17",
  "pages_build_output_dir": "./dist",
  "vars": {
    "PUBLIC_ORIGIN": "https://patientradar.kr",
    "PROBE_ENABLED": "false",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "patient-radar-production",
      "database_id": "fc9ea01c-5f65-4ea5-a534-cd7a50005669",
    },
  ],
}
